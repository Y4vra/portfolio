---
const { id, class: className, ...rest } = Astro.props;
---

<section 
  id={id} 
  class:list={["relative overflow-hidden", className]} 
  {...rest}
>
  <div 
    class="absolute inset-0 pointer-events-none -z-10 
           bg-light-bg dark:bg-dark-bg opacity-40
           [mask-image:radial-gradient(ellipse_90%_55%_at_center_50%,black_10%,transparent_65%)]
           [-webkit-mask-image:radial-gradient(ellipse_90%_55%_at_center_50%,black_10%,transparent_65%)]"
  ></div>

  <div class="relative z-10">
    <slot />
  </div>
</section>