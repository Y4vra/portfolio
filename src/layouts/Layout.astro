---
import "@fontsource-variable/inter";
import "@fontsource-variable/fira-code";
import "../styles/global.css";

const title = "Javier Carrasco Arango · Portfolio";
const description = "Portfolio of Javier Carrasco Arango (Y4vra), Software Engineering student focused on full-stack development, cybersecurity and team leadership.";
const canonical = new URL(import.meta.env.BASE_URL, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}/projectImages/visual-oscillator.webp`.replace(/\/{2,}/g, "/"), Astro.site);
---

<!doctype html>
<html class="transition-colors duration-500 ease-in-out overflow-y-scroll scroll-smooth" lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + "/favicon.svg"} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />

		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			(function () {
				var stored = null;
				try { stored = localStorage.getItem("theme"); } catch (e) {}
				var dark = stored ? stored === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			})();
		</script>
	</head>
	<body class="
		bg-light-bg dark:bg-dark-bg
		text-light-main-900 dark:text-dark-main-50">
		<slot name="navigation"/>
		<div
		id="background"
		aria-hidden="true"
		class="bg-dots-pattern fixed inset-0 z-0 -bottom-[20%] h-[120vh] w-full bg-repeat bg-center"
		></div>
		<style is:global>
		/* LIGHT MODE (Purple) */
		.bg-dots-pattern {
			background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='rgb%28108%2041%20255%29' fill-opacity='0.4'%3E%3Ccircle cx='10' cy='10' r='1.5'/%3E%3Ccircle cx='30' cy='30' r='1.5'/%3E%3C/g%3E%3C/svg%3E");
		}
		.dark .bg-dots-pattern {
			background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='rgb%28255%20201%2063%29' fill-opacity='0.4'%3E%3Ccircle cx='10' cy='10' r='1.5'/%3E%3Ccircle cx='30' cy='30' r='1.5'/%3E%3C/g%3E%3C/svg%3E");
		}
		</style>
		<main class="relative z-10">
			<slot name="start"/>
			<slot name="projects"/>
			<slot name="about"/>
			<slot name="contact"/>
		</main>
		<script>
			// Parallax: only recompute when the page actually scrolls or resizes.
			const background = document.getElementById('background');
			let ticking = false;

			function moveBackground() {
				ticking = false;
				if (!background) return;
				const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
				const scrollPercent = maxScroll > 0 ? window.scrollY / maxScroll : 0;
				const moveAmount = scrollPercent * 100; // Moves it exactly 100px over the whole page
				background.style.transform = `translate3d(0, ${-moveAmount}px, 0)`;
			}

			function requestMove() {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(moveBackground);
				}
			}

			window.addEventListener('scroll', requestMove, { passive: true });
			window.addEventListener('resize', requestMove);
			requestMove();
		</script>
	</body>
</html>
